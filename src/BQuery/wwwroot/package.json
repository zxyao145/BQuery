{
  "name": "bquery",
  "type": "module",
  "version": "4.0.0",
  "packageManager": "pnpm@12.3.4",
  "description": "An extended library of interaction between blazor and js. And The name mimics jQuery.",
  "main": "bQuery.js",
  "scripts": {
    "dev": "vite build --config vite.config.js --mode development && node -e \"require('fs').copyFileSync('dist/bQuery.min.js','bQuery.min.js')\"",
    "build": "vite build --config vite.config.js --mode production && node -e \"require('fs').copyFileSync('dist/bQuery.min.js','bQuery.min.js')\"",
    "fmt": "biome format --write",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "lint:fix": "biome lint --write",
    "check": "biome check --write"
  },
  "keywords": [
    "bquery",
    "blazor",
    "interop"
  ],
  "author": "zxyao",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
