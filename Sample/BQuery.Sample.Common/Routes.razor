<CascadingValue Value="Mode" Name="ConfiguredMode" IsFixed="true">
    <Router AppAssembly="typeof(Routes).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(LabLayout)"/>
            <FocusOnNavigate RouteData="routeData" Selector="h1"/>
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(LabLayout)"><h1>Page not found</h1><a href="">Back to demos</a></LayoutView>
        </NotFound>
    </Router>
</CascadingValue>

@code { [Parameter] public string Mode { get; set; } = "Server"; }
